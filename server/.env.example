# Coaching Management System — Environment Variables
# Copy this file to .env and fill in the values.

# Node environment: development | test | production
NODE_ENV=development

# Server port
PORT=5000

# MongoDB connection string
# Local: mongodb://localhost:27017/coaching_management
# Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/coaching_management
MONGO_URI=mongodb://localhost:27017/coaching_management

# Secret for signing JWT tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters in production.
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-this

# Frontend URL for CORS
CLIENT_URL=http://localhost:3000